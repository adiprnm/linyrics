#!/usr/bin/env python3
"""lrc-tap — tap along with a song to produce a synced .lrc file.

Tujuan: lirik yang benar-benar sinkron untuk beberapa lagu favorit, tanpa
model ML dan tanpa menebak. MP3 diputar lewat mpv, kamu menekan tombol tiap
kali baris berganti, hasilnya .lrc di sebelah file audio (tempat Linyrics
mencarinya lebih dulu).

Tanpa dependensi Python di luar stdlib. Butuh `mpv` dan `ffprobe` (ffmpeg).
"""

from __future__ import annotations

