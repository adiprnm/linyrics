HELP = [
    ("Space/Enter", "tandai baris di posisi sekarang"),
    ("Backspace/u", "batalkan tanda terakhir"),
    ("↑ / ↓", "pindah baris tanpa menandai"),
    ("← / →", "mundur/maju 2 detik"),
    ("[ / ]", "mundur/maju 10 detik"),
    ("- / +", "geser baris terakhir ∓50 ms"),
    ("{ / }", "geser semua baris ∓100 ms"),
    ("p", "pause / lanjut"),
    ("g", "ke baris nomor…"),
    ("s", "simpan sekarang"),
    ("q / Q", "keluar (simpan / tanpa simpan)"),
]


class Tap:
    def __init__(self, args, path, title, artist, lines):
        self.args = args
        self.path = path
        self.title = title
        self.artist = artist
        self.lines = lines
        self.marks: list[float | None] = [None] * len(lines)
        self.cursor = 0
        self.message = "p = mulai memutar, lalu Space tiap baris berganti"
        self.message_until = time.time() + 6
        self.player = Player(path, args.mpv_arg)
        self.duration = self.player.duration()
        self.last_pos = None
        self.last_pos_at = 0.0

    # --- info ---
    def say(self, text):
        self.message = text
        self.message_until = time.time() + 4

    def position(self) -> float | None:
        return self.player.pos()

    # --- actions ---
    def tap(self):
        pos = self.position()
        if pos is None:
            self.say("belum ada posisi (mpv belum siap)")
            return
        if self.cursor >= len(self.lines):
            self.say("semua baris sudah ditandai")
            return
        self.marks[self.cursor] = pos
        self.cursor += 1
        if self.cursor >= len(self.lines):
            self.say("semua baris tertanda — 's' simpan, 'q' keluar")

    def undo(self):
        if self.cursor > 0:
            self.cursor -= 1
            self.marks[self.cursor] = None
            self.say(f"batal baris {self.cursor + 1}")

    def move(self, delta):
        self.cursor = max(0, min(len(self.lines) - 1, self.cursor + delta))

    def nudge(self, delta, all_lines=False):
        if all_lines:
            done = 0
            for i, m in enumerate(self.marks):
                if m is not None:
                    self.marks[i] = max(0.0, m + delta)
                    done += 1
            if done:
                self.say(f"semua {done} baris {'+' if delta > 0 else ''}{delta * 1000:.0f} ms")
        else:
            i = self.cursor - 1
            if i >= 0 and self.marks[i] is not None:
                self.marks[i] = max(0.0, self.marks[i] + delta)
                self.say(f"baris {i + 1} {'+' if delta > 0 else ''}{delta * 1000:.0f} ms")

    def goto(self, term: Term):
        # prompt singkat di status line
        if not term.tty:
            return
        buf = ""
        while True:
            self.render(term, prompt="baris nomor: " + buf + "▏")
            k = term.key(0.5)
            if not k:
                continue
            ch = k.decode("utf-8", "replace")
            if ch in ("\r", "\n"):
                break
            if ch in ("\x1b", "\x03"):
                return
            if ch in ("\x7f", "\x08"):
                buf = buf[:-1]
            elif ch.isdigit() and len(buf) < 4:
                buf += ch
        if buf:
            n = int(buf) - 1
            self.cursor = max(0, min(len(self.lines) - 1, n))

    # --- saving ---
    def save(self) -> str:
        out = self.args.output or (os.path.splitext(self.path)[0] + ".lrc")
        shift = self.args.offset / 1000.0
        rows = [(self.marks[i], self.lines[i]) for i in range(len(self.lines))
                if self.marks[i] is not None]
        if not rows:
            die("tidak ada baris yang ditandai, tidak ada yang disimpan")
        if os.path.exists(out):
            try:
                shutil.copyfile(out, out + ".bak")
            except OSError:
                pass
        body = []
        if self.title:
            body.append(f"[ti:{self.title}]")
        if self.artist:
            body.append(f"[ar:{self.artist}]")
        for t, text in rows:
            ms = max(0.0, t + shift)
            m = int(ms // 60)
            s = ms - m * 60
            body.append(f"[{m:02d}:{s:05.2f}]{text}")
        with open(out, "w", encoding="utf-8") as f:
            f.write("\n".join(body) + "\n")
        return out

    def render(self, term: Term, prompt: str | None = None):
        cols, rows = term.size()
        grid_w = max(40, cols - 26)
        now = time.time()
        if now - self.last_pos_at > 0.1:
            self.last_pos = self.player.pos()
            self.last_pos_at = now
            self.paused = self.player.paused()

        out = ["\x1b[H"]
        elapsed = self.last_pos
        total = self.duration or 0.0
        tracked = sum(1 for m in self.marks if m is not None)

        head = f" lrc-tap · {os.path.basename(self.path)}"
        timebit = f"{fmt_time(elapsed)} / {fmt_time(total)}"
        state = "PAUSE" if getattr(self, "paused", True) else "PLAY "
        line1 = pad(clip(head, cols - len(timebit) - 8), cols - len(timebit) - 8)
        out.append("\x1b[1;36m" + line1 + "\x1b[0m " + state + " " + timebit + "\x1b[K\r\n")

        bar_w = max(10, cols - 18)
        frac = (elapsed / total) if (elapsed is not None and total > 0) else 0.0
        filled = int(bar_w * max(0.0, min(1.0, frac)))
        out.append(" " + "\x1b[90m" + "─" * filled + "\x1b[0m" + "\x1b[90m"
                   + "─" * (bar_w - filled) + "\x1b[0m"
                   + f" {tracked}/{len(self.lines)}" + "\x1b[K\r\n")
        out.append("─" * cols + "\x1b[K\r\n")

        visible = max(4, rows - 9)
        start = max(0, min(self.cursor - visible // 2, max(0, len(self.lines) - visible)))
        for i in range(start, min(len(self.lines), start + visible)):
            mark = self.marks[i]
            marker = "▶" if i == self.cursor else " "
            tick = "✓" if mark is not None else " "
            num = f"{i + 1:3d}"
            ttxt = f"[{fmt_time(mark)}]" if mark is not None else "[   --:--.--]".replace("--:--.--", "  --.--")
            text = clip(self.lines[i], grid_w)
            if i == self.cursor:
                style = "\x1b[1;33m"
            elif mark is not None:
                style = "\x1b[32m"
            else:
                style = "\x1b[0m"
            out.append(f"{marker} {num} {tick} {ttxt} {style}{pad(text, grid_w)}\x1b[0m\x1b[K\r\n")
        for _ in range(visible - (min(len(self.lines), start + visible) - start)):
            out.append("\x1b[K\r\n")

        if prompt is not None:
            out.append("\x1b[1;35m " + prompt + "\x1b[0m\x1b[K\r\n")
        elif now < self.message_until and self.message:
            out.append("\x1b[1;35m " + clip(self.message, cols - 2) + "\x1b[0m\x1b[K\r\n")
        else:
            out.append("\x1b[K\r\n")

        keys = "  ".join(f"\x1b[1m{k}\x1b[0m {v}" for k, v in HELP[:6])
        keys2 = "  ".join(f"\x1b[1m{k}\x1b[0m {v}" for k, v in HELP[6:])
        out.append("\x1b[90m" + clip(keys, cols) + "\x1b[0m\x1b[K\r\n")
        out.append("\x1b[90m" + clip(keys2, cols) + "\x1b[0m\x1b[K\r\n")
        sys.stdout.write("".join(out))
        sys.stdout.flush()

    # --- main loop ---
    def run(self) -> int:
        save_now = False
        with Term() as term:
            if not term.tty:
                self.say("input bukan TTY: membaca tombol dari stdin")
                self.message = ""
            dirty = True
            while True:
                if dirty:
                    self.render(term)
                    dirty = False
                k = term.key(0.04)
                if k is None:
                    if time.time() - self.last_pos_at > 0.1:
                        dirty = True
                    continue
                if k == b"":  # stdin ditutup / sesi pipa selesai
                    save_now = True
                    break
                dirty = True
                stop = False
                for ch in decode_keys(k):
                    if ch == "\x03":
                        raise KeyboardInterrupt
                    if ch in (" ", "\r", "\n"):
                        self.tap()
                    elif ch in ("\x7f", "\x08", "u"):
                        self.undo()
                    elif ch == "\x1b[A":
                        self.move(-1)
                    elif ch == "\x1b[B":
                        self.move(1)
                    elif ch == "\x1b[D":
                        self.player.nudge(-2.0)
                    elif ch == "\x1b[C":
                        self.player.nudge(2.0)
                    elif ch == "[":
                        self.player.nudge(-10.0)
                    elif ch == "]":
                        self.player.nudge(10.0)
                    elif ch == "-":
                        self.nudge(-0.05)
                    elif ch in ("+", "="):
                        self.nudge(0.05)
                    elif ch == "{":
                        self.nudge(-0.1, all_lines=True)
                    elif ch == "}":
                        self.nudge(0.1, all_lines=True)
                    elif ch == "p":
                        self.player.toggle_pause()
                    elif ch == "g":
                        self.goto(term)
                        dirty = True
                        break
                    elif ch in ("s", "q", "Q"):
                        save_now = ch in ("s", "q")
                        stop = True
                        break
                    else:
                        continue
                if stop:
                    break
            self.player.close()
        return 0 if save_now else 2


