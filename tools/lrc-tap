def probe_tags(path: str) -> tuple[str, str, float]:
    """title, artist, duration (ffprobe; semua boleh kosong)."""
    title = artist = ""
    duration = 0.0
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries",
             "format=duration:format_tags=title,artist", "-of", "json", path],
            capture_output=True, text=True, timeout=20).stdout
        data = json.loads(out or "{}")
        fmt = data.get("format", {})
        tags = {k.lower(): v for k, v in (fmt.get("tags") or {}).items()}
        title = tags.get("title", "")
        artist = tags.get("artist", "")
        duration = float(fmt.get("duration") or 0.0)
    except Exception:
        pass

    base = os.path.splitext(os.path.basename(path))[0]
    base = re.sub(r"^\(\d{4}\)\s*", "", base)          # "(2002) Element - Rahasia Hati"
    base = re.sub(r"\[[^\]]*\]|\([^)]*\)", " ", base)   # noise brackets
    base = re.sub(r"\s+", " ", base).strip(" -_")
    if " - " in base:
        left, right = base.split(" - ", 1)
        artist = artist or left.strip()
        title = title or right.strip()
    else:
        title = title or base
    return title.strip(), artist.strip(), duration


def http_json(url: str) -> object | None:
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except Exception:
        return None


def clean_artist(artist: str) -> str:
    a = re.sub(r"\s*[-–]\s*topic\s*$", "", artist, flags=re.I)
    a = re.sub(r"\s*vevo\s*$", "", a, flags=re.I)
    a = re.sub(r"\s+official\s*$", "", a, flags=re.I)
    return a.strip()


def clean_title(title: str, artist: str) -> str:
    t = re.sub(r"[\(\[\{][^\)\]\}]*[\)\]\}]", " ", title)      # buang (...) [..] {..}
    t = re.sub(r"\s+(feat\.?|ft\.?)\s+.*$", "", t, flags=re.I)
    t = re.sub(r"\s+", " ", t).strip(" -–|")
    if " - " in t:
        left, right = t.split(" - ", 1)
        first = artist.split()[0].lower() if artist.strip() else ""
        if (first and first in left.lower()) or not first:
            t = right.strip(" -–|")
    return t.strip()


def lrclib_lookup(title: str, artist: str, duration: float):
    """Return (synced, plain) strings; keduanya boleh None."""
    title = clean_title(title, artist)
    artist = clean_artist(artist)
    if not title:
        return None, None

    urls = []
    base = "https://lrclib.net/api/search?"
    if artist:
        urls.append(base + "track_name=" + urllib.parse.quote(title)
                    + "&artist_name=" + urllib.parse.quote(artist))
    urls.append(base + "track_name=" + urllib.parse.quote(title))
    if artist:
        urls.append(base + "q=" + urllib.parse.quote(artist + " " + title))

    best_synced = best_plain = None
    best_s = 1e9
    for url in urls:
        data = http_json(url)
        if not isinstance(data, list):
            continue
        for item in data:
            if not isinstance(item, dict):
                continue
            dur = item.get("duration") or 0
            # durasi beda jauh = versi lain; jangan dipakai
            if duration and dur and abs(dur - duration) > 30:
                continue
            score = abs(dur - duration) if (duration and dur) else 5.0
            synced, plain = item.get("syncedLyrics"), item.get("plainLyrics")
            if synced and score < best_s:
                best_s = score
                best_synced = synced
            if plain and best_plain is None:
                best_plain = plain
        if best_synced:
            break
    return best_synced, best_plain


# ---------------------------------------------------------------------------
# mpv over its JSON IPC socket
# ---------------------------------------------------------------------------


class Player:
    def __init__(self, path: str, mpv_args: list[str]):
        if not shutil.which("mpv"):
            die("mpv tidak ditemukan (sudo pacman -S mpv)")
        self.tmp = tempfile.mkdtemp(prefix="lrc-tap-")
        self.sock_path = os.path.join(self.tmp, "mpv.sock")
        self.proc = subprocess.Popen(
            ["mpv", "--no-video", "--no-terminal", "--really-quiet", "--pause",
             "--input-ipc-server=" + self.sock_path, *mpv_args, path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.sock = None
        self.stream = None
        self.req_id = 0
        for _ in range(200):
            if os.path.exists(self.sock_path):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(self.sock_path)
                    self.sock = s
                    self.stream = s.makefile("rwb")
                    break
                except OSError:
                    pass
            if self.proc.poll() is not None:
                die("mpv gagal dijalankan")
            time.sleep(0.05)
        if not self.stream:
            die("tidak bisa terhubung ke mpv")

    def cmd(self, *args):
        self.req_id += 1
        rid = self.req_id
        self.stream.write((json.dumps({"command": list(args), "request_id": rid}) + "\n").encode())
        self.stream.flush()
        while True:
            line = self.stream.readline()
            if not line:
                return {}
            try:
                msg = json.loads(line.decode("utf-8", "replace"))
            except json.JSONDecodeError:
                continue
            if msg.get("request_id") == rid:
                return msg

    def pos(self) -> float | None:
        v = self.cmd("get_property", "time-pos").get("data")
        return float(v) if isinstance(v, (int, float)) else None

    def duration(self) -> float:
        v = self.cmd("get_property", "duration").get("data")
        return float(v) if isinstance(v, (int, float)) else 0.0

    def paused(self) -> bool:
        return bool(self.cmd("get_property", "pause").get("data"))

    def toggle_pause(self):
        self.cmd("cycle", "pause")

    def seek(self, seconds: float):
        self.cmd("seek", seconds, "absolute+exact")

    def nudge(self, seconds: float):
        self.cmd("seek", seconds, "relative+exact")

    def close(self):
        try:
            self.cmd("quit")
        except Exception:
            pass
        try:
            if self.stream:
                self.stream.close()
            if self.sock:
                self.sock.close()
        except Exception:
            pass
        try:
            self.proc.wait(timeout=3)
        except Exception:
            self.proc.kill()
        shutil.rmtree(self.tmp, ignore_errors=True)


