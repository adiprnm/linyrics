def read_lines_from_file(path: str) -> list[str]:
    if path == "-":
        raw = sys.stdin.read()
    else:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            raw = f.read()
    out = []
    for ln in raw.splitlines():
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        # buang timestamp kalau user memberi lrc mentah
        ln = re.sub(r"^(\[[0-9:.]+\])+\s*", "", ln)
        out.append(ln)
    return out


def prompt_lines() -> list[str]:
    if not sys.stdin.isatty():
        return read_lines_from_file("-")
    print("Tempel/ketik lirik (satu baris per baris).")
    print("Akhiri dengan baris berisi satu titik (.) — Enter kosong = selesai.\n")
    out = []
    while True:
        try:
            ln = input()
        except EOFError:
            break
        if ln.strip() == ".":
            break
        if not ln.strip():
            if out:
                break
            continue
        out.append(ln.strip())
    return out


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="lrc-tap",
        description="Bikin file .lrc sinkron dengan mengetuk tombol mengikuti lagu.")
    ap.add_argument("audio", help="file audio (mp3/flac/m4a/...)")
    ap.add_argument("-l", "--lyrics", help="file teks lirik ('-' = stdin)")
    ap.add_argument("-o", "--output", help="tulis .lrc ke path ini (default: sebelah file audio)")
    ap.add_argument("--offset", type=int, default=0, metavar="MS",
                    help="geser semua timestamp sebanyak MS saat menyimpan (default 0)")
    ap.add_argument("--no-lrclib", action="store_true", help="jangan cari teks lirik ke LRCLIB")
    ap.add_argument("--mpv-arg", action="append", default=[], metavar="ARG",
                    help="argumen tambahan untuk mpv (bisa diulang), mis. --mpv-arg=--ao=null")
    ap.add_argument("--version", action="version", version=f"lrc-tap {VERSION}")
    args = ap.parse_args()

    path = os.path.abspath(os.path.expanduser(args.audio))
    if not os.path.isfile(path):
        die(f"file tidak ditemukan: {path}")
    for tool in ("ffprobe", "mpv"):
        if not shutil.which(tool):
            die(f"butuh '{tool}' di PATH")

    title, artist, duration = probe_tags(path)

    lines: list[str] = []
    if args.lyrics:
        lines = read_lines_from_file(args.lyrics)
    elif not args.no_lrclib:
        synced, plain = lrclib_lookup(title, artist, duration)
        if synced:
            out = args.output or (os.path.splitext(path)[0] + ".lrc")
            if os.path.exists(out):
                shutil.copyfile(out, out + ".bak")
            with open(out, "w", encoding="utf-8") as f:
                f.write(synced.rstrip() + "\n")
            print(f"LRCLIB sudah punya lirik sinkron untuk lagu ini → disimpan: {out}")
            print("Tidak perlu mengetuk apa pun. (Pakai --no-lrclib untuk tetap mengetuk manual.)")
            return 0
        if plain:
            lines = read_lines_from_file_from_text(plain)
            print(f"Teks lirik diambil dari LRCLIB ({len(lines)} baris).")

    if not lines:
        lines = prompt_lines()
    if not lines:
        die("tidak ada baris lirik; pakai -l FILE atau tempel saat diminta")

    print(f"\n{title or '?'} — {artist or '?'}")
    print(f"{len(lines)} baris siap. mpv mulai dalam keadaan pause — tekan 'p' untuk memutar.\n")

    app = Tap(args, path, title, artist, lines)
    try:
        code = app.run()
    except KeyboardInterrupt:
        app.player.close()
        print("\nDibatalkan, tidak ada yang disimpan.")
        return 130

    if code == 2:
        print("\nKeluar tanpa menyimpan.")
        return 2

    out = app.save()
    tapped = sum(1 for m in app.marks if m is not None)
    print(f"\nTersimpan: {out}")
    print(f"  {tapped}/{len(lines)} baris bertanda")
    if tapped < len(lines):
        print(f"  ({len(lines) - tapped} baris tidak ditandai tidak ikut disimpan)")
    print("\nLinyrics membaca .lrc di sebelah file audio lebih dulu.")
    print("Kalau lagunya sedang diputar, tekan R di jendela Linyrics untuk memuat ulang.")
    return 0


def read_lines_from_file_from_text(text: str) -> list[str]:
    out = []
    for ln in text.splitlines():
        ln = ln.strip()
        if ln and not ln.startswith("#"):
            out.append(ln)
    return out


