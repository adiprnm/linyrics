import json
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import tempfile
import termios
import time
import tty
import unicodedata
import urllib.parse
import urllib.request

VERSION = "1.0.0"
UA = "linyrics-lrc-tap/1.0 (https://github.com/adipurnm/linyrics)"

# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------


def eprint(*a):
    print(*a, file=sys.stderr)


def die(msg: str) -> "NoReturn":  # noqa: F821
    eprint("lrc-tap: " + msg)
    sys.exit(1)


def fmt_time(sec: float | None) -> str:
    if sec is None or sec < 0:
        return "--:--.--"
    m = int(sec // 60)
    s = sec - m * 60
    return f"{m:02d}:{s:05.2f}"


def disp_width(text: str) -> int:
    w = 0
    for ch in text:
        w += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return w


def clip(text: str, width: int) -> str:
    if disp_width(text) <= width:
        return text
    out, w = [], 0
    for ch in text:
        cw = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if w + cw > width - 1:
            out.append("…")
            break
        out.append(ch)
        w += cw
    return "".join(out)


def pad(text: str, width: int) -> str:
    return text + " " * max(0, width - disp_width(text))


ARROWS = {"\x1b[A": "up", "\x1b[B": "down", "\x1b[C": "right", "\x1b[D": "left"}


def decode_keys(data: bytes) -> list[str]:
    """Satu read() bisa berisi beberapa tombol; pecah jadi token."""
    text = data.decode("utf-8", "replace")
    keys: list[str] = []
    i = 0
    while i < len(text):
        seq = text[i:i + 3]
        if seq in ARROWS:
            keys.append(seq)
            i += 3
            continue
        keys.append(text[i])
        i += 1
    return keys


